+import { describe, expect, it } from "vitest";
+
+import type { Milestone } from "./milestone";
+import {
+  applyMilestoneAction,
+  availableActions,
+  milestoneViewer,
+  reviewLinkProblem,
+  revisionCount,
+  reviewsFor,
+  startNextMilestone,
+  type TransitionInput,
+} from "./review";
+import { SAMPLE_MILESTONE_REVIEWS, SAMPLE_MILESTONES, sampleMilestoneSituation } from "./sample";
+
+const milestone = (status: Milestone["status"], overrides: Partial<Milestone> = {}): Milestone => ({
+  ...SAMPLE_MILESTONES[1],
+  status,
+  submitted_at: null,
+  approved_at: null,
+  ...overrides,
+});
+
+const input = (overrides: Partial<TransitionInput>): TransitionInput => ({
+  action: "submit",
+  viewer: "lead",
+  note: "Ready on staging.",
+  author_name: "Ada",
+  at: "2026-12-20T10:00:00Z",
+  review_id: 900,
+  ...overrides,
+});
+
+describe("milestoneViewer", () => {
+  it("picks the client first, then the Lead, then a member; nobody else", () => {
+    expect(milestoneViewer({ is_owner: true, is_lead: false, is_member: false })).toBe("client");
+    expect(milestoneViewer({ is_owner: false, is_lead: true, is_member: true })).toBe("lead");
+    expect(milestoneViewer({ is_owner: false, is_lead: false, is_member: true })).toBe("member");
+    expect(milestoneViewer({ is_owner: false, is_lead: false, is_member: false })).toBeNull();
+  });
+});
+
+describe("availableActions", () => {
+  it("lets the Lead submit only work in progress", () => {
+    expect(availableActions("in_progress", "lead")).toEqual(["submit"]);
+    expect(availableActions("under_review", "lead")).toEqual([]);
+    expect(availableActions("pending_deposit", "lead")).toEqual([]);
+  });
+
+  it("lets the client approve or send back only work under review", () => {
+    expect(availableActions("under_review", "client")).toEqual(["approve", "request_revision"]);
+    expect(availableActions("in_progress", "client")).toEqual([]);
+    expect(availableActions("completed", "client")).toEqual([]);
+  });
+
+  it("gives members no actions", () => {
+    for (const status of ["pending_deposit", "not_started", "in_progress", "under_review", "completed"] as const) {
+      expect(availableActions(status, "member")).toEqual([]);
+    }
+  });
+});
+
+describe("applyMilestoneAction: the review loop", () => {
+  it("submit → under review, recording when and the Lead's note and link", () => {
+    const result = applyMilestoneAction(milestone("in_progress"), input({ link_url: " https://staging.example.com " }));
+    expect(result).toMatchObject({
+      ok: true,
+      milestone: { status: "under_review", submitted_at: "2026-12-20T10:00:00Z" },
+      review: { kind: "submitted", note: "Ready on staging.", link_url: "https://staging.example.com", author_role: "lead" },
+    });
+  });
+
+  it("request revision → back in progress, keeping the client's note", () => {
+    const result = applyMilestoneAction(
+      milestone("under_review"),
+      input({ action: "request_revision", viewer: "client", note: "  Fix the email. ", author_name: "Grace" }),
+    );
+    expect(result).toMatchObject({
+      ok: true,
+      milestone: { status: "in_progress", approved_at: null },
+      review: { kind: "revision_requested", note: "Fix the email.", link_url: null, author_role: "client" },
+    });
+  });
+
+  it("approve → completed, with no note needed", () => {
+    const result = applyMilestoneAction(milestone("under_review"), input({ action: "approve", viewer: "client", note: "" }));
+    expect(result).toMatchObject({ ok: true, milestone: { status: "completed", approved_at: "2026-12-20T10:00:00Z" } });
+  });
+
+  it("goes round the loop until approved", () => {
+    let current = milestone("in_progress");
+    const steps: TransitionInput[] = [
+      input({}),
+      input({ action: "request_revision", viewer: "client", note: "Change X." }),
+      input({}),
+      input({ action: "approve", viewer: "client", note: "" }),
+    ];
+    const statuses = steps.map((step) => {
+      const result = applyMilestoneAction(current, step);
+      if (!result.ok) throw new Error(result.reason);
+      current = result.milestone;
+      return current.status;
+    });
+    expect(statuses).toEqual(["under_review", "in_progress", "under_review", "completed"]);
+  });
+
+  it("refuses the wrong person, the wrong state, a missing note and a bad link", () => {
+    expect(applyMilestoneAction(milestone("in_progress"), input({ viewer: "client" }))).toEqual({
+      ok: false,
+      reason: "Only the Team Lead submits milestone work.",
+    });
+    expect(applyMilestoneAction(milestone("under_review"), input({ action: "approve", viewer: "member" }))).toEqual({
+      ok: false,
+      reason: "Only the client reviews milestone work.",
+    });
+    expect(applyMilestoneAction(milestone("pending_deposit"), input({}))).toMatchObject({ ok: false });
+    expect(applyMilestoneAction(milestone("completed"), input({ action: "approve", viewer: "client" }))).toMatchObject({
+      ok: false,
+    });
+    expect(applyMilestoneAction(milestone("in_progress"), input({ note: "   " }))).toEqual({
+      ok: false,
+      reason: "Say what is ready for the client to review.",
+    });
+    expect(
+      applyMilestoneAction(milestone("under_review"), input({ action: "request_revision", viewer: "client", note: "" })),
+    ).toEqual({ ok: false, reason: "Say what needs to change." });
+    expect(applyMilestoneAction(milestone("in_progress"), input({ link_url: "http://plain.example.com" }))).toMatchObject({
+      ok: false,
+    });
+  });
+});
+
+describe("reviewLinkProblem", () => {
+  it("accepts nothing or an https link", () => {
+    expect(reviewLinkProblem("")).toBeNull();
+    expect(reviewLinkProblem(null)).toBeNull();
+    expect(reviewLinkProblem("https://github.com/org/repo/pull/1")).toBeNull();
+    expect(reviewLinkProblem("staging.example.com")).toBe("Enter a full link, such as https://staging.example.com.");
+    expect(reviewLinkProblem("http://example.com")).toBe("Use a link that starts with https://.");
+  });
+});
+
+describe("startNextMilestone", () => {
+  it("starts the first milestone not started once nothing else is open", () => {
+    const after = startNextMilestone(sampleMilestoneSituation("under_review").milestones.map((m) =>
+      m.sequence === 2 ? { ...m, status: "completed" as const } : m,
+    ));
+    expect(after.map((m) => m.status)).toEqual(["completed", "completed", "in_progress", "not_started"]);
+  });
+
+  it("changes nothing while a milestone is still open", () => {
+    const before = sampleMilestoneSituation("under_review").milestones;
+    expect(startNextMilestone(before).map((m) => m.status)).toEqual(before.map((m) => m.status));
+  });
+});
+
+describe("history helpers and sample data", () => {
+  it("counts revisions and orders history oldest first", () => {
+    expect(revisionCount(SAMPLE_MILESTONE_REVIEWS, 1)).toBe(1);
+    expect(revisionCount(SAMPLE_MILESTONE_REVIEWS, 3)).toBe(0);
+    expect(reviewsFor(SAMPLE_MILESTONE_REVIEWS, 2).map((r) => r.kind)).toEqual([
+      "submitted",
+      "revision_requested",
+      "submitted",
+    ]);
+  });
+
+  it("keeps each sample situation consistent with its history", () => {
+    for (const situation of ["awaiting_deposit", "revision_requested", "under_review", "all_completed"] as const) {
+      const { milestones, reviews } = sampleMilestoneSituation(situation);
+      for (const m of milestones) {
+        const last = reviewsFor(reviews, m.id).at(-1);
+        const expected =
+          m.status === "completed" ? "approved" : m.status === "under_review" ? "submitted" : m.status === "in_progress" ? "revision_requested" : undefined;
+        expect(last?.kind, `${situation}, milestone ${m.sequence}`).toBe(expected);
+      }
+    }
+    expect(sampleMilestoneSituation("no_milestones").milestones).toEqual([]);
+  });
+});
diff --git a/frontend/src/entities/milestone/model/review.ts b/frontend/src/entities/milestone/model/review.ts
new file mode 100644
index 0000000..a2db16d
--- /dev/null
+++ b/frontend/src/entities/milestone/model/review.ts
@@ -0,0 +1,181 @@
+/**
+ * Milestone delivery and review (Phase 2, NN-16b #95; stakeholder Q1).
+ *
+ * The Team Lead submits a milestone's work, the client approves it or asks
+ * for a revision, and the loop repeats until it is approved:
+ *
+ *   Pending deposit → In progress → Under review → Completed
+ *                          ↑              │
+ *                          └── revision ──┘
+ *
+ * PROTOTYPE: there is no milestone API yet. These are the planned API shapes
+ * and the transitions the backend will own as domain methods (backlog
+ * NN-16b, "Backend note"). Every transition also writes one review event, so
+ * the history is the audit trail of the loop.
+ */
+import type { Milestone, MilestoneStatus } from "./milestone";
+
+/** Who is looking at a milestone. People outside the project never see one. */
+export type MilestoneViewer = "client" | "lead" | "member";
+
+export type MilestoneReviewKind = "submitted" | "revision_requested" | "approved";
+
+/** One step of a milestone's review history (planned `GET /projects/:id/milestones/:id/reviews`). */
+export type MilestoneReview = {
+  id: number;
+  milestone_id: number;
+  kind: MilestoneReviewKind;
+  /** The Lead's summary of the work, or the client's requested changes; empty on a plain approval. */
+  note: string;
+  /** Where the client can see the work (staging site, pull request, demo video); optional. */
+  link_url: string | null;
+  author_name: string;
+  author_role: "client" | "lead";
+  /** ISO timestamp. */
+  created_at: string;
+};
+
+export type MilestoneAction = "submit" | "approve" | "request_revision";
+
+export const REVIEW_RULES = {
+  noteMax: 2000,
+  /** The Lead says what is ready; the client says what to change. An approval needs no words. */
+  noteRequired: { submit: true, request_revision: true, approve: false } satisfies Record<MilestoneAction, boolean>,
+} as const;
+
+export const REVIEW_KIND_LABEL: Record<MilestoneReviewKind, string> = {
+  submitted: "Submitted for review",
+  revision_requested: "Revision requested",
+  approved: "Approved",
+};
+
+export function milestoneViewer(viewer: { is_owner: boolean; is_lead: boolean; is_member: boolean }): MilestoneViewer | null {
+  if (viewer.is_owner) return "client";
+  if (viewer.is_lead) return "lead";
+  if (viewer.is_member) return "member";
+  return null;
+}
+
+const ACTOR: Record<MilestoneAction, MilestoneViewer> = {
+  submit: "lead",
+  approve: "client",
+  request_revision: "client",
+};
+
+const FROM: Record<MilestoneAction, MilestoneStatus> = {
+  submit: "in_progress",
+  approve: "under_review",
+  request_revision: "under_review",
+};
+
+/** The actions this viewer can take on this milestone right now (empty for members). */
+export function availableActions(status: MilestoneStatus, viewer: MilestoneViewer): MilestoneAction[] {
+  return (Object.keys(ACTOR) as MilestoneAction[]).filter((action) => ACTOR[action] === viewer && FROM[action] === status);
+}
+
+export type TransitionInput = {
+  action: MilestoneAction;
+  viewer: MilestoneViewer;
+  note: string;
+  link_url?: string | null;
+  author_name: string;
+  at: string;
+  /** Id for the new review event. */
+  review_id: number;
+};
+
+export type TransitionResult =
+  | { ok: true; milestone: Milestone; review: MilestoneReview }
+  | { ok: false; reason: string };
+
+/** Why a note cannot be sent, in plain words; `null` when it can. */
+export function reviewNoteProblem(action: MilestoneAction, note: string): string | null {
+  const text = note.trim();
+  if (REVIEW_RULES.noteRequired[action] && !text) {
+    return action === "submit" ? "Say what is ready for the client to review." : "Say what needs to change.";
+  }
+  if (text.length > REVIEW_RULES.noteMax) return `Keep it under ${REVIEW_RULES.noteMax} characters.`;
+  return null;
+}
+
+/** Why a link cannot be sent; `null` when it is empty or a valid https link. */
+export function reviewLinkProblem(link: string | null | undefined): string | null {
+  const value = link?.trim();
+  if (!value) return null;
+  try {
+    return new URL(value).protocol === "https:" ? null : "Use a link that starts with https://.";
+  } catch {
+    return "Enter a full link, such as https://staging.example.com.";
+  }
+}
+
+/**
+ * Applies one step of the review loop. Pure: returns the milestone's next
+ * state and the history event, or why the step is not allowed. The backend
+ * will enforce the same rules (`Milestone.submit()`, `.approve()`,
+ * `.request_revision()`).
+ */
+export function applyMilestoneAction(milestone: Milestone, input: TransitionInput): TransitionResult {
+  const { action, viewer } = input;
+  if (ACTOR[action] !== viewer) {
+    return {
+      ok: false,
+      reason: action === "submit" ? "Only the Team Lead submits milestone work." : "Only the client reviews milestone work.",
+    };
+  }
+  if (milestone.status !== FROM[action]) {
+    return {
+      ok: false,
+      reason:
+        action === "submit"
+          ? "Only a milestone in progress can be submitted."
+          : "Only a milestone under review can be approved or sent back.",
+    };
+  }
+  const noteProblem = reviewNoteProblem(action, input.note);
+  if (noteProblem) return { ok: false, reason: noteProblem };
+  const link = action === "submit" ? input.link_url?.trim() || null : null;
+  const linkProblem = reviewLinkProblem(link);
+  if (linkProblem) return { ok: false, reason: linkProblem };
+
+  const next: Milestone =
+    action === "submit"
+      ? { ...milestone, status: "under_review", submitted_at: input.at }
+      : action === "approve"
+        ? { ...milestone, status: "completed", approved_at: input.at }
+        : { ...milestone, status: "in_progress" };
+
+  const review: MilestoneReview = {
+    id: input.review_id,
+    milestone_id: milestone.id,
+    kind: action === "submit" ? "submitted" : action === "approve" ? "approved" : "revision_requested",
+    note: input.note.trim(),
+    link_url: link,
+    author_name: input.author_name,
+    author_role: viewer === "client" ? "client" : "lead",
+    created_at: input.at,
+  };
+  return { ok: true, milestone: next, review };
+}
+
+/**
+ * After an approval, work moves on to the next milestone in order: the first
+ * one not started yet becomes in progress. (Prototype assumption; see the
+ * NN-16b backend note.)
+ */
+export function startNextMilestone(milestones: readonly Milestone[]): Milestone[] {
+  const ordered = [...milestones].sort((a, b) => a.sequence - b.sequence);
+  if (ordered.some((m) => m.status === "in_progress" || m.status === "under_review")) return ordered;
+  const next = ordered.find((m) => m.status === "not_started");
+  return ordered.map((m) => (m === next ? { ...m, status: "in_progress" } : m));
+}
+
+/** How many times the client has sent this milestone back. */
+export function revisionCount(reviews: readonly MilestoneReview[], milestoneId: number): number {
+  return reviews.filter((r) => r.milestone_id === milestoneId && r.kind === "revision_requested").length;
+}
+
+/** A milestone's history, oldest first. */
+export function reviewsFor(reviews: readonly MilestoneReview[], milestoneId: number): MilestoneReview[] {
+  return reviews.filter((r) => r.milestone_id === milestoneId).sort((a, b) => a.created_at.localeCompare(b.created_at));
+}
