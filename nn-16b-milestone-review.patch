+/* ---------- Review history (NN-16b #95) ---------- */
+
+const LEAD = { author_name: "Ada", author_role: "lead" as const };
+const CLIENT = { author_name: "Grace", author_role: "client" as const };
+const STAGING = "https://staging.example.com";
