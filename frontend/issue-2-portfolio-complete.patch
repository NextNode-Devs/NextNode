+import { ArrowLeftIcon, LockIcon } from "lucide-react";
+import Link from "next/link";
+import { redirect } from "next/navigation";
+import { Suspense } from "react";
+
+import { getMyPortfolio } from "@/entities/developer";
+import { getViewer, routeFor } from "@/entities/viewer";
+import { EditPortfolioForm } from "@/features/edit-portfolio";
+import { authedServerApi } from "@/shared/api/server-client";
+import { LoadError, LoadingCards } from "@/shared/ui/load-states";
+import { StateCard } from "@/shared/ui/molecules/state-card";
+import { Button } from "@/shared/ui/shadcn/button";
+import { AppHeader } from "@/widgets/app-header";
+
+/** `/developers/me/edit`: the signed-in developer edits their own portfolio. */
+export function EditPortfolioView() {
+  return (
+    <>
+      <AppHeader current="developers" />
+      <main className="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-6 px-4 py-6 sm:px-6 sm:py-10">
+        <Link
+          href="/developers/me"
+          className="inline-flex w-fit items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
+        >
+          <ArrowLeftIcon className="size-4" aria-hidden /> Back to your portfolio
+        </Link>
+        <Suspense fallback={<LoadingCards count={3} label="Loading your portfolio" />}>
+          <EditScreen />
+        </Suspense>
+      </main>
+    </>
+  );
+}
+
+async function EditScreen() {
+  const route = routeFor(await getViewer());
+  if (route.kind === "sign-in") redirect("/sign-in?redirect_url=/developers/me/edit");
+  if (route.kind === "onboarding") redirect("/onboarding");
+  if (route.kind === "error") {
+    return (
+      <>
+        <h1 className="sr-only">Edit your portfolio</h1>
+        <LoadError title="We couldn't load your portfolio" message={route.message} />
+      </>
+    );
+  }
+  if (route.viewer.account.role !== "developer") {
+    return (
+      <StateCard
+        as="h1"
+        icon={<LockIcon aria-hidden />}
+        title="Only developers have a portfolio"
+        message="Your account is a client account, so there's no portfolio to edit. You can browse developers and open theirs."
+        action={
+          <Button asChild variant="outline">
+            <Link href="/developers">Browse developers</Link>
+          </Button>
+        }
+      />
+    );
+  }
+
+  const result = await getMyPortfolio(authedServerApi);
+  if (!result.ok) {
+    return (
+      <>
+        <h1 className="sr-only">Edit your portfolio</h1>
+        <LoadError title="We couldn't load your portfolio" message={result.error.message} />
+      </>
+    );
+  }
+  return (
+    <>
+      <header className="space-y-1">
+        <h1 className="text-2xl font-semibold tracking-tight sm:text-3xl">Edit your portfolio</h1>
+        <p className="text-muted-foreground">
+          Clients and other developers see this when they open your portfolio from the directory.
+        </p>
+      </header>
+      <EditPortfolioForm portfolio={result.data} />
+    </>
+  );
+}
diff --git a/frontend/src/views/portfolio/ui/portfolio-actions.tsx b/frontend/src/views/portfolio/ui/portfolio-actions.tsx
new file mode 100644
index 0000000..e8f6a6e
--- /dev/null
+++ b/frontend/src/views/portfolio/ui/portfolio-actions.tsx
@@ -0,0 +1,35 @@
+import type { ReactNode } from "react";
+
+import type { Portfolio } from "@/entities/developer";
+import type { Role } from "@/entities/viewer";
+
+type Props = {
+  portfolio: Portfolio;
+  viewerRole: Role;
+};
+
+/**
+ * What a viewer in this role may start from someone else's portfolio. Empty
+ * until the hiring issues add their actions, so no control is shown that does
+ * nothing yet:
+ * - #4 (Hire Lead) adds "Invite to lead…" for `client`, shown when they have an
+ *   open project that needs a Team Lead.
+ * - #5 (Hire Devs) adds "Invite to my team…" for `developer`, shown only to
+ *   Team Leads with open spots (Team Lead is per project, never a role).
+ * They are separate actions with separate labels.
+ */
+export function actionsFor(portfolio: Portfolio, viewerRole: Role): ReactNode[] {
+  const actions: Record<Role, ReactNode[]> = {
+    client: [], // #4: <InviteToLead key="invite-to-lead" developerId={portfolio.account_id} />
+    developer: [], // #5: <InviteToTeam key="invite-to-team" developerId={portfolio.account_id} />
+  };
+  return actions[viewerRole];
+}
+
+/** The action area on a portfolio (#2's integration contract for #4 and #5).
+ * Never shown to the portfolio's owner, whatever the actions are. */
+export function PortfolioActions({ portfolio, viewerRole }: Props) {
+  if (portfolio.is_owner) return null;
+  const actions = actionsFor(portfolio, viewerRole);
+  return actions.length ? <>{actions}</> : null;
+}
diff --git a/frontend/src/views/portfolio/ui/portfolio-view.tsx b/frontend/src/views/portfolio/ui/portfolio-view.tsx
new file mode 100644
index 0000000..230489f
--- /dev/null
+++ b/frontend/src/views/portfolio/ui/portfolio-view.tsx
@@ -0,0 +1,138 @@
+import { ArrowLeftIcon, CircleCheckIcon, LockIcon, PencilIcon, SearchXIcon } from "lucide-react";
+import Link from "next/link";
+import { redirect } from "next/navigation";
+import { Suspense } from "react";
+
+import { getPortfolio, PortfolioProfile, portfolioHref } from "@/entities/developer";
+import { getViewer, routeFor } from "@/entities/viewer";
+import { authedServerApi } from "@/shared/api/server-client";
+import { LoadError, LoadingCards } from "@/shared/ui/load-states";
+import { StateCard } from "@/shared/ui/molecules/state-card";
+import { Alert, AlertDescription, AlertTitle } from "@/shared/ui/shadcn/alert";
+import { Button } from "@/shared/ui/shadcn/button";
+import { AppHeader } from "@/widgets/app-header";
+
+import { PortfolioActions } from "./portfolio-actions";
+
+type Props = {
+  /** A developer's account id, or `"me"` for the signed-in developer's own. */
+  developerId: Promise<string>;
+  /** `?saved=1` after the owner saves, so the change is confirmed on the page they land on. */
+  saved?: Promise<boolean>;
+};
+
+/** `/developers/[id]`: a developer's portfolio, for any signed-in user. */
+export function PortfolioView(props: Props) {
+  return (
+    <>
+      <AppHeader current="developers" />
+      <main className="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-6 px-4 py-6 sm:px-6 sm:py-10">
+        <Link
+          href="/developers"
+          className="inline-flex w-fit items-center gap-1 text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
+        >
+          <ArrowLeftIcon className="size-4" aria-hidden /> All developers
+        </Link>
+        <Suspense fallback={<LoadingCards count={2} label="Loading the portfolio" />}>
+          <PortfolioScreen {...props} />
+        </Suspense>
+      </main>
+    </>
+  );
+}
+
+const directoryLink = (
+  <Button asChild variant="outline">
+    <Link href="/developers">Browse developers</Link>
+  </Button>
+);
+
+async function PortfolioScreen({ developerId, saved }: Props) {
+  const id = await developerId;
+  const route = routeFor(await getViewer());
+  if (route.kind === "sign-in") redirect(`/sign-in?redirect_url=/developers/${encodeURIComponent(id)}`);
+  if (route.kind === "onboarding") redirect("/onboarding");
+  if (route.kind === "error") {
+    return (
+      <>
+        <h1 className="sr-only">Portfolio</h1>
+        <LoadError title="We couldn't load this portfolio" message={route.message} />
+      </>
+    );
+  }
+
+  const me = route.viewer.account;
+  if (id === "me") {
+    if (me.role === "developer") redirect(portfolioHref(me.id));
+    return (
+      <StateCard
+        as="h1"
+        icon={<LockIcon aria-hidden />}
+        title="Clients don't have a portfolio"
+        message="Portfolios belong to developer accounts. You can browse developers and open theirs."
+        action={directoryLink}
+      />
+    );
+  }
+
+  const accountId = /^\d+$/.test(id) ? Number(id) : null;
+  const result = accountId ? await getPortfolio(authedServerApi, accountId) : null;
+  if (!result || (!result.ok && result.error.code === "NOT_FOUND")) {
+    return (
+      <StateCard
+        as="h1"
+        icon={<SearchXIcon aria-hidden />}
+        title="Developer not found"
+        message="This link doesn't match a developer on NextNode. It may be mistyped, or the account may belong to a client."
+        action={directoryLink}
+      />
+    );
+  }
+  if (!result.ok && result.error.code === "FORBIDDEN") {
+    return (
+      <StateCard
+        as="h1"
+        icon={<LockIcon aria-hidden />}
+        title="You can't view this portfolio"
+        message={result.error.message}
+        action={directoryLink}
+      />
+    );
+  }
+  if (!result.ok) {
+    return (
+      <>
+        <h1 className="sr-only">Portfolio</h1>
+        <LoadError title="We couldn't load this portfolio" message={result.error.message} />
+      </>
+    );
+  }
+
+  const portfolio = result.data;
+  const justSaved = portfolio.is_owner && (await saved);
+  return (
+    <>
+      {justSaved ? (
+        <Alert role="status" className="border-success/40">
+          <CircleCheckIcon className="text-success" aria-hidden />
+          <AlertTitle>Portfolio saved</AlertTitle>
+          <AlertDescription>This is how clients and other developers see it now.</AlertDescription>
+        </Alert>
+      ) : null}
+      <PortfolioProfile
+        portfolio={portfolio}
+        actions={
+          portfolio.is_owner ? (
+            <Button asChild>
+              <Link href="/developers/me/edit">
+                <PencilIcon aria-hidden /> Edit portfolio
+              </Link>
+            </Button>
+          ) : (
+            <PortfolioActions portfolio={portfolio} viewerRole={me.role} />
+          )
+        }
+      />
+    </>
+  );
+}
diff --git a/frontend/src/views/portfolio/ui/portfolio.test.tsx b/frontend/src/views/portfolio/ui/portfolio.test.tsx
new file mode 100644
index 0000000..761d7f7
--- /dev/null
+++ b/frontend/src/views/portfolio/ui/portfolio.test.tsx
@@ -0,0 +1,74 @@
+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+
+import { PortfolioProfile, type Portfolio } from "@/entities/developer";
+
+import { actionsFor, PortfolioActions } from "./portfolio-actions";
+
+const PORTFOLIO: Portfolio = {
+  account_id: 7,
+  display_name: "Ada Lovelace",
+  headline: "Full-stack developer",
+  bio: "I build things.",
+  github_username: "ada",
+  github_url: "https://github.com/ada",
+  skills: [{ key: "react", label: "React" }],
+  projects: [
+    { title: "Engine", repository_url: "https://github.com/ada/engine", demo_url: "https://engine.example.com" },
+    { title: "Notes", repository_url: "https://github.com/ada/notes", demo_url: null },
+  ],
+  resume_url: "https://example.com/cv.pdf",
+  is_available: true,
+  is_owner: false,
+};
+
+describe("PortfolioProfile", () => {
+  it("shows every part of the portfolio, with links opening safely in a new tab", () => {
+    render(<PortfolioProfile portfolio={PORTFOLIO} />);
+    expect(screen.getByRole("heading", { level: 1, name: "Ada Lovelace" })).toBeInTheDocument();
+    expect(screen.getByText("Available for work")).toBeInTheDocument();
+    const repos = screen.getAllByRole("link", { name: /Repository/ });
+    expect(repos.map((a) => a.getAttribute("href"))).toEqual([
+      "https://github.com/ada/engine",
+      "https://github.com/ada/notes",
+    ]);
+    expect(screen.getAllByRole("link", { name: /Live demo/ })).toHaveLength(1);
+    const github = screen.getByRole("link", { name: /GitHub: ada/ });
+    expect(github).toHaveAttribute("target", "_blank");
+    expect(github.getAttribute("rel")).toContain("noopener");
+    expect(screen.getByRole("link", { name: /Resume/ })).toHaveAttribute("href", "https://example.com/cv.pdf");
+  });
+
+  it("never says verified", () => {
+    const { container } = render(<PortfolioProfile portfolio={PORTFOLIO} />);
+    expect(container.textContent?.toLowerCase()).not.toContain("verified");
+  });
+
+  it("never turns a non-web link into something clickable", () => {
+    render(<PortfolioProfile portfolio={{ ...PORTFOLIO, resume_url: "javascript:alert(1)" }} />);
+    expect(screen.queryByRole("link", { name: /Resume/ })).not.toBeInTheDocument();
+  });
+
+  it("says plainly what a new portfolio doesn't have yet", () => {
+    const empty = { ...PORTFOLIO, bio: "", projects: [], github_url: null, github_username: null, resume_url: null };
+    render(<PortfolioProfile portfolio={{ ...empty, is_available: false }} />);
+    expect(screen.getByText("No bio yet.")).toBeInTheDocument();
+    expect(screen.getByText("No projects added yet.")).toBeInTheDocument();
+    expect(screen.getByText("No GitHub profile or resume added.")).toBeInTheDocument();
+    expect(screen.queryByText("Available for work")).not.toBeInTheDocument();
+  });
+});
+
+describe("PortfolioActions (the slot #4 and #5 fill)", () => {
+  it("is never shown to the portfolio's owner", () => {
+    const { container } = render(<PortfolioActions portfolio={{ ...PORTFOLIO, is_owner: true }} viewerRole="client" />);
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("renders no control until #4 and #5 provide one, so nothing shown does nothing", () => {
+    expect(actionsFor(PORTFOLIO, "client")).toEqual([]);
+    expect(actionsFor(PORTFOLIO, "developer")).toEqual([]);
+    const { container } = render(<PortfolioActions portfolio={PORTFOLIO} viewerRole="client" />);
+    expect(container).toBeEmptyDOMElement();
+  });
+});
