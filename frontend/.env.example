# Copy to .env.local. Placeholders only — never commit real values.

# Server-only: where the Next.js server reaches the Django API.
API_BASE_URL=http://localhost:8000

# Clerk development instance (#1, docs/external-accounts.md). Leave both empty to
# run without sign-in: protected pages then redirect to /sign-in, which says so.
# Publishable key: public by design (pk_test_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key: server-only, never in client code, logs or issues (sk_test_...).
CLERK_SECRET_KEY=

# Browser-side: the Django API (CORS allows FRONTEND_ORIGIN) and its socket endpoint.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
