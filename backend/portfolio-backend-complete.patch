+        {"title": "Notes", "repository_url": REPO},
+    ],
+    "resume_url": "https://example.com/cv.pdf",
+    "is_available": True,
+}
+
+
+@pytest.fixture(autouse=True)
+def container(verifier):
+    with override_container(token_verifier=verifier):
