# Copy to backend/.env for local development. Placeholders only — never commit
# real values. In deployed environments set these as real environment variables.

# development | test | production
DJANGO_ENV=development
DJANGO_DEBUG=true
# Any long random string locally. Production refuses short or "change-me" values.
DJANGO_SECRET_KEY=change-me-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API (CORS + CSRF trusted origins).
FRONTEND_ORIGIN=http://localhost:3000

# Matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://nextnode:nextnode@localhost:5432/nextnode

# Clerk — leave CLERK_ISSUER empty to run without auth (every token is refused).
# CLERK_ISSUER is the instance's Frontend API URL, e.g. https://<slug>.clerk.accounts.dev
CLERK_ISSUER=
# Optional: defaults to $CLERK_ISSUER/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional: defaults to FRONTEND_ORIGIN
CLERK_AUTHORIZED_PARTIES=

# Stripe, test mode only (#7). Backend only: never in the frontend, logs, docs or issues.
# Leave both empty to run without payments (the webhook answers 503).
# Test secret key from the Stripe dashboard (Developers > API keys), test mode.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:8000/api/payments/stripe/webhook/`.
STRIPE_WEBHOOK_SECRET=
# Deposit as a percentage of the accepted offer total (confirmed: 20).
DEPOSIT_PERCENT=20
